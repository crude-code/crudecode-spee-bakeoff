# Copy to .env (gitignored — keep it that way; this repo is public).
# Both scripts also accept these from the environment directly.

# Postgres connection string for scripts/extract_pads.py (snapshot
# extraction). Nothing else touches the database; scoring and tests run
# entirely off the extracted benchmark_data/ snapshot.
BENCHMARK_DB_URL=

# Anthropic API key for scripts/run_llm.py (new LLM benchmark runs).
# Not needed to score existing forecasts or to run the test suite.
ANTHROPIC_API_KEY=
